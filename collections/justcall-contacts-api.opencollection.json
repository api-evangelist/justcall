{
  "opencollection": "1.0.0",
  "info": {
    "name": "JustCall REST Calls Contacts API",
    "version": "2.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Contacts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create a contact",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.justcall.io/v2.1/contacts",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Adds a new contact to the JustCall Contacts section."
        }
      ]
    }
  ],
  "bundled": true
}